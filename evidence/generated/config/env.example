# --- Application environment (development secrets are placeholders only) ---
# NEVER commit real secrets. Replace these with strong values before any
# deployment that is reachable beyond localhost.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_USER=app
MYSQL_PASSWORD=CHANGE_ME_app
DB_PORT=13306

APP_ENV=production
APP_PORT=8085
VULN_PORT=8086

AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
SESSION_SECURE=0

# Admin bootstrap password. Leave blank to generate a random password that is
# written to db/seed-output/ADMIN_PASSWORD.txt on first seed (file is git-ignored).
ADMIN_PASSWORD=
